# Copy to .env (dev) or set in your host's dashboard (prod). Everything here is PUBLIC —
# VITE_ variables are bundled into the browser code. Never put a secret key in this file.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SITE_URL=http://localhost:5173
VITE_CONTACT_EMAIL=contact@example.com
VITE_GOVERNING_LAW=
# Optional: privacy-friendly analytics (loads only after cookie consent)
VITE_PLAUSIBLE_DOMAIN=
# Optional: Cloudflare Turnstile PUBLIC site key (the secret key lives in backend/.env)
VITE_TURNSTILE_SITE_KEY=
