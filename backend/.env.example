# Copy to backend/.env  (never commit .env — it is git-ignored)
APP_ENV=development            # set to "production" when deployed
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # prod: https://your-domain.com
FORCE_HTTPS=false              # defaults to true when APP_ENV=production
TRUST_PROXY=false              # true when behind Render/Railway/Fly/Nginx so X-Forwarded-* is honoured
IP_HASH_SALT=generate_a_random_32_byte_hex_salt_for_ip_hashing

# Supabase -> Project Settings > API. Use the SERVICE ROLE key here (server only!)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Upstash Redis -> your database > REST API
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token-here

# Cloudflare Turnstile secret (optional bot challenge; leave empty to disable)
TURNSTILE_SECRET_KEY=

